APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# API
API_CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=60

# LLM provider. Keep models configurable so upgrades do not require code changes.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.1
OPENAI_API_KEY=
LITELLM_API_KEY=

# Embedding and reranking
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
RERANKER_PROVIDER=local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Stores
DATABASE_URL=postgresql+asyncpg://bankbot:bankbot@localhost:5432/bankbot
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vietcombank_public_docs

# Data pipeline
VIETCOMBANK_BASE_URL=https://www.vietcombank.com.vn
CRAWLER_USER_AGENT=BankChatbotResearchCrawler/1.0
CRAWLER_REQUEST_DELAY_SECONDS=1.0

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
