APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# API
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-vercel-app.vercel.app
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_BACKEND=redis

# Web deploy. Vercel should set BACKEND_API_URL to the Render API URL.
# NEXT_PUBLIC_API_BASE_URL is optional; leave empty to use the Vercel rewrite.
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=

# LLM provider. Keep models configurable so upgrades do not require code changes.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.1
OPENAI_API_KEY=
LITELLM_API_KEY=
COHERE_API_KEY=

# Embedding and reranking
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
RERANKER_PROVIDER=local
RERANKER_MODEL=rerank-v4.0-fast
RERANKER_MAX_DOCUMENTS=64
RERANKER_REQUEST_TIMEOUT_SECONDS=4

# RAG latency controls
RAG_CACHE_ENABLED=true
RAG_CACHE_BACKEND=redis
RAG_CACHE_TTL_SECONDS=300
RAG_CACHE_MAX_ENTRIES=512
QDRANT_REQUEST_TIMEOUT_SECONDS=6

# Stores
DATABASE_URL=postgresql+asyncpg://bankbot:bankbot@localhost:5432/bankbot
# Use the same managed Redis endpoint for local and production.
# This project does not create a Redis server in Docker Compose.
# Use rediss:// when your provider requires TLS.
REDIS_URL=rediss://default:CHANGE_ME@managed-redis.example.com:6380/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vietcombank_public_docs
QDRANT_RECREATE_COLLECTION=false
RAG_DATA_ROOT=data

# Data pipeline
VIETCOMBANK_BASE_URL=https://www.vietcombank.com.vn
CRAWLER_USER_AGENT=BankChatbotResearchCrawler/1.0
CRAWLER_REQUEST_DELAY_SECONDS=1.0

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
